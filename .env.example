# Postgres connection string. Works with any Postgres server — a local
# Docker container, a managed service, etc. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://orgdirectory:orgdirectory@localhost:5432/orgdirectory

# Set to "true" to connect over SSL (needed by most managed/hosted Postgres
# providers). Leave unset or "false" for a local Postgres container, which
# usually doesn't have SSL configured.
DATABASE_SSL=false

# Random hex string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
